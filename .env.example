# DS2API runtime
# Runtime listen port inside the app/container
PORT=5001
# Docker Compose host port (compose only; container still listens on PORT)
DS2API_HOST_PORT=6011
LOG_LEVEL=INFO

# Admin authentication
DS2API_ADMIN_KEY=change-me

# Config loading (choose one)
# 1) file-based config
DS2API_CONFIG_PATH=/app/config.json
# 2) inline JSON or Base64 JSON
# DS2API_CONFIG_JSON=
# 3) legacy compatibility alias
# CONFIG_JSON=

# Account credentials (recommended: set this ONLY in your deployment platform's
# encrypted Environment Variables / Secrets UI; never commit real values here).
# When set, this account pool overrides accounts from config.json.
# DS2API_ACCOUNTS_JSON=[{"name":"account-1","email":"user1@example.com","password":"replace-me"},{"name":"account-2","email":"user2@example.com","password":"replace-me"}]
# Docker/Kubernetes secret-file alternative:
# DS2API_ACCOUNTS_JSON_FILE=/run/secrets/ds2api_accounts_json

# Normal availability/load-balancing controls. These are not intended to bypass
# provider quotas or anti-abuse controls.
# DS2API_ACCOUNT_MAX_INFLIGHT=2
# DS2API_ACCOUNT_MAX_QUEUE=20
# DS2API_GLOBAL_MAX_INFLIGHT=4

# Optional: static admin assets path
# DS2API_STATIC_ADMIN_DIR=/app/static/admin
